{
  "description": "review-kit policy: no destructive SQL from any session that enables this plugin",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/block_sql_drop.py\""
          }
        ]
      }
    ]
  }
}
